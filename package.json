{
  "name": "aviation-intercept",
  "version": "0.1.0",
  "description": "V2 aviation emergency simulator shipped as Aviation Intercept",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prepare:local-aip-assets": "node scripts/prepare_local_aip_assets.js",
    "clean:local-aip-assets": "node scripts/prepare_local_aip_assets.js --clean",
    "build:local-aip": "node scripts/build_local_aip.js",
    "preview": "vite preview",
    "lint": "eslint src --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "test": "node --import ./tests/support/register-json-loader.mjs --test",
    "generate:failure-descriptions": "node scripts/generate_failure_descriptions.js",
    "update:failure-graph": "node scripts/update_failure_graph.js",
    "apply:failure-graph": "node scripts/update_failure_graph.js --apply-approved",
    "generate:narratives": "node scripts/generate_narratives.js",
    "fetch:authoritative-sources": "node scripts/fetch_authoritative_sources.js",
    "process:failure-graph": "node scripts/process_failure_graph.js",
    "build:failure-pipeline": "npm run fetch:authoritative-sources && npm run process:failure-graph",
    "build:atc-phraseology": "node scripts/build_atc_phraseology_pipeline.js",
    "export:aip-supabase-csv": "node scripts/export_aip_supabase_csv.js",
    "import:aip-supabase-csv": "node scripts/import_aip_supabase_csv.js",
    "deploy:aip-supabase": "./scripts/deploy_aip_supabase.sh",
    "test:aip-route-search": "node scripts/test_aip_route_search_smoke.js",
    "test:aip-supabase-rpc": "node scripts/test_aip_supabase_rpc_smoke.js",
    "predeploy": "npm run build:local-aip",
    "deploy": "gh-pages -d dist",
    "build:scenery-packs": "node scripts/build_scenery_packs.js",
    "test:scenery-import": "node --import ./tests/support/register-json-loader.mjs --test tests/scenery_pack_import.test.js tests/scenery_storage_migration.test.js",
    "fetch:scenery-packs": "node scripts/import_airport_ground.js --optional --resume",
    "build:aip-packs": "node scripts/build_aip_packs.js",
    "stage:release": "npm run build:local-aip && node scripts/stage_release.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.98.0",
    "dotenv": "^16.6.1",
    "fflate": "^0.8.3",
    "pdf-parse": "^1.1.1",
    "polygon-clipping": "^0.15.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "fake-indexeddb": "^6.2.6",
    "gh-pages": "^6.1.1",
    "postcss": "^8.4.27",
    "tailwindcss": "^3.3.3",
    "vite": "^4.4.5"
  }
}
